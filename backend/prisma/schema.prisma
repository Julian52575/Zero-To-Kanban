generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TodoItem {
  id        String  @id @default(uuid())
  name      String
  completed Boolean @default(false)

  @@map("todo_items")
}

model Project {
  id        String  @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  @@map("projects")
}

model ProcessedEvent {
  eventId     String   @id
  processedAt DateTime @default(now())
}